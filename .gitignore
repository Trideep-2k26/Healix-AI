*.local.md
notes/

# Logs (extended patterns)
*.pid
*.seed
*.pid.lock

# Prevent accidental lockfile changes from other managers (uncomment if standardizing on npm)
# yarn.lock
# pnpm-lock.yaml
# bun.lockb

# Ignore dump / export data
*.sqlite
*.sqlite-journal
dump.sql
backup.sql

# Generated assets (if you build and optimize images locally)
optimized-assets/

# Ignore previous Lottie demo artifacts (if recreated locally)
*.lottie

# AI / tooling metadata (not needed in production builds)
.bolt/
# If you later want to share AI prompt configuration, remove the line above and
# whitelist a specific file e.g.:
# !.bolt/config.public.json
